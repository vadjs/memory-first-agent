# Azure OpenAI / Foundry
AZURE_OPENAI_ENDPOINT=            # https://<account>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=             # empty when USE_MANAGED_IDENTITY=true
CHAT_DEPLOYMENT=gpt-5.6-luna
UTILITY_DEPLOYMENT=gpt-5-nano
EMBED_DEPLOYMENT=text-embedding-3-small
USE_MANAGED_IDENTITY=false        # true in Azure: keyless auth via managed identity

# Web search
TAVILY_API_KEY=

# Memory
REDIS_URL=redis://localhost:6379

# Routing thresholds (similarity, per index — see ADR-0004)
CACHE_THRESHOLD=0.85
CHUNK_THRESHOLD=0.70
BORDERLINE_FLOOR=0.55
SLOW_TTL_DAYS=7
TOP_K=5

# Reliability
SEARCH_TIMEOUT_S=5
FETCH_TIMEOUT_S=10
LLM_TIMEOUT_S=30
UTILITY_TIMEOUT_S=15
DEGRADED_ANSWERS=true

# HTTP API
API_KEY=                          # bearer key; empty disables auth (local dev)
RATE_LIMIT_PER_MIN=30
MAX_QUERY_CHARS=2000
